# Firebase web app config.
# Copy this file to .env.local and fill in the values from:
#   Firebase console > Project settings > Your apps > SDK setup and configuration
#
# .env.local is gitignored. These values are not secrets (they ship in the JS
# bundle) -- access is controlled by Authentication > Settings > Authorized
# domains and by your security rules.
#
# CRA reads env vars only at startup: restart `npm start` after editing.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# API host. Locally this is the json-server from `npm run server` (db.json on
# port 8080), which is also the default if this is unset. For a deployed build,
# point it at the hosted API.
REACT_APP_API_URL=http://localhost:8080
